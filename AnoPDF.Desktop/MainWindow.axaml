<Window x:Class="AnoPDF.Desktop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnoPDF"
        Width="1120"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        Background="#F3F4F6">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom"
                Background="#FFFFFF"
                BorderBrush="#D7DCE2"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="StatusText"
                       Text="준비됨" />
        </Border>

        <Grid>
            <Grid x:Name="StartView">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="320">
                    <Button x:Name="StartOpenButton"
                            Height="44"
                            HorizontalContentAlignment="Center"
                            Click="OpenButton_Click"
                            Content="Open File"
                            FontSize="15"
                            ToolTip.Tip="PDF 파일 열기" />

                    <TextBlock x:Name="SelectedPathText"
                               Margin="0,14,0,0"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#4B5563"
                               Text="선택된 파일 없음" />
                </StackPanel>
            </Grid>

            <DockPanel x:Name="ViewerView"
                       IsVisible="False"
                       LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="#FFFFFF"
                        BorderBrush="#D7DCE2"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="OpenButton"
                                Width="88"
                                Height="34"
                                HorizontalContentAlignment="Center"
                                Click="OpenButton_Click"
                                Content="Open File"
                                ToolTip.Tip="PDF 파일 열기" />

                        <TextBlock x:Name="DocumentTitleText"
                                   Grid.Column="1"
                                   Margin="14,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   Text="PDF 없음"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="PageCountText"
                                       Width="82"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="#374151"
                                       Text="0 pages" />

                            <Button x:Name="RenderDocumentButton"
                                    Width="126"
                                    Height="34"
                                    Margin="0,0,12,0"
                                    HorizontalContentAlignment="Center"
                                    Click="RenderDocumentButton_Click"
                                    Content="Render Document"
                                    ToolTip.Tip="문서 전체 다시 렌더링" />

                            <Slider x:Name="ZoomSlider"
                                    Width="130"
                                    Minimum="0.5"
                                    Maximum="2.5"
                                    Value="1"
                                    TickFrequency="0.25"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="ZoomSlider_ValueChanged"
                                    ToolTip.Tip="확대율" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Border Padding="24">
                        <StackPanel x:Name="PageStack"
                                    MinWidth="320"
                                    MinHeight="320"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="24" />
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
