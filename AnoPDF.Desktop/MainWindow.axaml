<Window x:Class="AnoPDF.Desktop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnoPDF.Desktop"
        Title="AnoPDF"
        Width="1120"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        Background="#F3F4F6">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom"
                Background="#FFFFFF"
                BorderBrush="#D7DCE2"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="StatusText"
                       Text="Ready" />
        </Border>

        <Border x:Name="DrawingToolbar"
                DockPanel.Dock="Bottom"
                Background="#F9FAFB"
                BorderBrush="#D7DCE2"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                <TextBlock VerticalAlignment="Center"
                           Foreground="#374151"
                           FontWeight="SemiBold"
                           Text="Draw" />

                <Button x:Name="PanToolButton"
                        Width="64"
                        Height="32"
                        HorizontalContentAlignment="Center"
                        Click="PanToolButton_Click"
                        Content="Pan"
                        ToolTip.Tip="Pan document" />
                <Button x:Name="PenToolButton"
                        Width="64"
                        Height="32"
                        HorizontalContentAlignment="Center"
                        Click="PenToolButton_Click"
                        Content="Pen"
                        ToolTip.Tip="Draw with pen" />
                <Button x:Name="HighlighterToolButton"
                        Width="96"
                        Height="32"
                        HorizontalContentAlignment="Center"
                        Content="Highlighter"
                        ToolTip.Tip="Draw with highlighter" />
                <Button x:Name="EraserToolButton"
                        Width="72"
                        Height="32"
                        HorizontalContentAlignment="Center"
                        Content="Eraser"
                        ToolTip.Tip="Erase drawing strokes" />

                <Border Width="1"
                        Height="24"
                        Margin="4,0"
                        Background="#D7DCE2" />

                <TextBlock VerticalAlignment="Center"
                           Foreground="#374151"
                           Text="Color" />
                <local:HslRgbTriangleColorPicker x:Name="HslRgbTriangleColorPicker"
                                                 Width="96"
                                                 Height="72"
                                                 ToolTip.Tip="HSL triangle color wheel" />

                <Border Width="1"
                        Height="24"
                        Margin="4,0"
                        Background="#D7DCE2" />

                <TextBlock VerticalAlignment="Center"
                           Foreground="#374151"
                           Text="Width" />
                <Slider x:Name="StrokeWidthSlider"
                        Width="120"
                        Minimum="1"
                        Maximum="16"
                        Value="3"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="StrokeWidthSlider_ValueChanged"
                        ToolTip.Tip="Stroke width" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid x:Name="StartView">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="320">
                    <TextBlock x:Name="SelectedPathText"
                               Width="220"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#4B5563"
                               Text="No file selected" />

                    <Button x:Name="DirectFileDialogButton"
                            Width="220"
                            Height="44"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Background="#2563EB"
                            Foreground="#FFFFFF"
                            Click="OpenButton_Click"
                            Content="Open"
                            FontSize="15"
                            ToolTip.Tip="Open PDF file dialog" />
                </StackPanel>
            </Grid>

            <DockPanel x:Name="ViewerView"
                       IsVisible="False"
                       LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="#FFFFFF"
                        BorderBrush="#D7DCE2"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="OpenButton"
                                Width="88"
                                Height="34"
                                HorizontalContentAlignment="Center"
                                Click="OpenButton_Click"
                                Content="Open File"
                                ToolTip.Tip="Open PDF file dialog" />

                        <TextBlock x:Name="DocumentTitleText"
                                   Grid.Column="1"
                                   Margin="14,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   Text="No PDF"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="PageCountText"
                                       Width="82"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="#374151"
                                       Text="0 pages" />

                            <Button x:Name="RenderDocumentButton"
                                    Width="126"
                                    Height="34"
                                    Margin="0,0,12,0"
                                    HorizontalContentAlignment="Center"
                                    Click="RenderDocumentButton_Click"
                                    Content="Render Document"
                                    ToolTip.Tip="Render the whole document again" />

                            <Slider x:Name="ZoomSlider"
                                    Width="130"
                                    Minimum="0.5"
                                    Maximum="2.5"
                                    Value="1"
                                    TickFrequency="0.25"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="ZoomSlider_ValueChanged"
                                    ToolTip.Tip="Zoom" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Border Padding="24">
                        <StackPanel x:Name="PageStack"
                                    MinWidth="320"
                                    MinHeight="320"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="24" />
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
