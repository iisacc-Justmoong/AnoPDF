<Window x:Class="AnoPDF.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnoPDF"
        Width="1120"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        Background="#F3F4F6">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="#FFFFFF"
                BorderBrush="#D7DCE2"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="OpenButton"
                        Width="88"
                        Height="34"
                        Click="OpenButton_Click"
                        Content="열기"
                        ToolTip="PDF 열기" />

                <TextBlock x:Name="DocumentTitleText"
                           Grid.Column="1"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Text="PDF 없음"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="RenderPageButton"
                            Width="96"
                            Height="34"
                            Margin="0,0,12,0"
                            Click="RenderPageButton_Click"
                            Content="Render Page"
                            ToolTip="현재 페이지 다시 렌더링" />

                    <Button x:Name="PreviousPageButton"
                            Width="34"
                            Height="34"
                            Click="PreviousPageButton_Click"
                            Content="‹"
                            FontSize="20"
                            ToolTip="이전 페이지" />

                    <TextBlock x:Name="PageNumberText"
                               Width="76"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="#374151"
                               Text="0 / 0" />

                    <Button x:Name="NextPageButton"
                            Width="34"
                            Height="34"
                            Click="NextPageButton_Click"
                            Content="›"
                            FontSize="20"
                            ToolTip="다음 페이지" />

                    <Slider x:Name="ZoomSlider"
                            Width="130"
                            Margin="16,0,0,0"
                            Minimum="0.5"
                            Maximum="2.5"
                            Value="1"
                            TickFrequency="0.25"
                            IsSnapToTickEnabled="True"
                            ValueChanged="ZoomSlider_ValueChanged"
                            ToolTip="확대율" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom"
                   BorderBrush="#D7DCE2"
                   BorderThickness="0,1,0,0"
                   Background="#FFFFFF">
            <TextBlock x:Name="StatusText"
                       Text="준비됨" />
        </StatusBar>

        <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <Grid x:Name="DocumentHost"
                      MinWidth="320"
                      MinHeight="320">
                    <Border x:Name="PageFrame"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="#FFFFFF"
                            BorderBrush="#D7DCE2"
                            BorderThickness="1"
                            Padding="0">
                        <Image x:Name="PageImage"
                               Stretch="None"
                               SnapsToDevicePixels="True" />
                    </Border>
                </Grid>
            </ScrollViewer>

            <TextBlock x:Name="EmptyStateText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       Foreground="#6B7280"
                       Text="PDF 없음" />
        </Grid>
    </DockPanel>
</Window>
