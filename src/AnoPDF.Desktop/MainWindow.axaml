<Window x:Class="AnoPDF.Desktop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnoPDF.Desktop"
        Title="AnoPDF"
        Width="1120"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        Background="#E5E7EB">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom"
                Background="#0F172A"
                BorderBrush="#020617"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock x:Name="StatusText"
                       Foreground="#F8FAFC"
                       FontSize="13"
                       Text="Ready" />
        </Border>

        <Border x:Name="DrawingToolbar"
                DockPanel.Dock="Bottom"
                Background="#111827"
                BorderBrush="#020617"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           Text="Draw" />

                <Button x:Name="PanToolButton"
                        Width="72"
                        Height="38"
                        HorizontalContentAlignment="Center"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Click="PanToolButton_Click"
                        Content="Pan"
                        Foreground="#0F172A"
                        FontWeight="SemiBold"
                        ToolTip.Tip="Pan document" />
                <Button x:Name="PenToolButton"
                        Width="72"
                        Height="38"
                        HorizontalContentAlignment="Center"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Click="PenToolButton_Click"
                        Content="Pen"
                        Foreground="#0F172A"
                        FontWeight="SemiBold"
                        ToolTip.Tip="Draw with pen" />
                <Button x:Name="HighlighterToolButton"
                        Width="112"
                        Height="38"
                        HorizontalContentAlignment="Center"
                        Background="#E2E8F0"
                        BorderBrush="#94A3B8"
                        BorderThickness="1"
                        Content="Highlighter"
                        Foreground="#334155"
                        ToolTip.Tip="Draw with highlighter" />
                <Button x:Name="EraserToolButton"
                        Width="82"
                        Height="38"
                        HorizontalContentAlignment="Center"
                        Background="#E2E8F0"
                        BorderBrush="#94A3B8"
                        BorderThickness="1"
                        Content="Eraser"
                        Foreground="#334155"
                        ToolTip.Tip="Erase drawing strokes" />

                <Border Width="1"
                        Height="30"
                        Margin="4,0"
                        Background="#475569" />

                <TextBlock VerticalAlignment="Center"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           Text="Color" />
                <local:HslRgbTriangleColorPicker x:Name="HslRgbTriangleColorPicker"
                                                 Width="96"
                                                 Height="72"
                                                 ToolTip.Tip="HSL triangle color wheel" />

                <Border Width="1"
                        Height="30"
                        Margin="4,0"
                        Background="#475569" />

                <TextBlock VerticalAlignment="Center"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           Text="Width" />
                <Slider x:Name="StrokeWidthSlider"
                        Width="120"
                        Minimum="1"
                        Maximum="16"
                        Value="3"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="StrokeWidthSlider_ValueChanged"
                        ToolTip.Tip="Stroke width" />
            </StackPanel>
        </Border>

        <Grid Background="#E5E7EB">
            <Grid x:Name="StartView">
                <Border x:Name="StartPanel"
                        Width="420"
                        Padding="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel HorizontalAlignment="Stretch"
                                Spacing="18">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#0F172A"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Text="AnoPDF" />
                        <TextBlock x:Name="SelectedPathText"
                                   Width="300"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#334155"
                                   FontSize="14"
                                   Text="No file selected" />

                        <Button x:Name="DirectFileDialogButton"
                                Width="260"
                                Height="50"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Background="#0F62FE"
                                BorderBrush="#0B4FCC"
                                BorderThickness="1"
                                Click="OpenButton_Click"
                                Content="Open"
                                Foreground="#FFFFFF"
                                FontSize="16"
                                FontWeight="SemiBold"
                                ToolTip.Tip="Open PDF file dialog" />
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel x:Name="ViewerView"
                       IsVisible="False"
                       LastChildFill="True">
                <Border x:Name="ViewerTopBar"
                        DockPanel.Dock="Top"
                        Background="#0F172A"
                        BorderBrush="#020617"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="OpenButton"
                                Width="104"
                                Height="40"
                                HorizontalContentAlignment="Center"
                                Background="#0F62FE"
                                BorderBrush="#0B4FCC"
                                BorderThickness="1"
                                Click="OpenButton_Click"
                                Content="Open File"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                ToolTip.Tip="Open PDF file dialog" />

                        <TextBlock x:Name="DocumentTitleText"
                                   Grid.Column="1"
                                   Margin="18,0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   Text="No PDF"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="PageCountText"
                                       Width="82"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="#CBD5E1"
                                       FontWeight="SemiBold"
                                       Text="0 pages" />

                            <Button x:Name="RenderDocumentButton"
                                    Width="144"
                                    Height="40"
                                    Margin="0,0,12,0"
                                    HorizontalContentAlignment="Center"
                                    Background="#F8FAFC"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Click="RenderDocumentButton_Click"
                                    Content="Render Document"
                                    Foreground="#0F172A"
                                    FontWeight="SemiBold"
                                    ToolTip.Tip="Render the whole document again" />

                            <Slider x:Name="ZoomSlider"
                                    Width="130"
                                    Minimum="0.5"
                                    Maximum="2.5"
                                    Value="1"
                                    TickFrequency="0.25"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="ZoomSlider_ValueChanged"
                                    ToolTip.Tip="Zoom" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Border Padding="28"
                            Background="#E5E7EB">
                        <StackPanel x:Name="PageStack"
                                    MinWidth="320"
                                    MinHeight="320"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="24" />
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
